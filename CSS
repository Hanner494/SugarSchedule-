:root {
  --bg: #fff7ff;
  --text: #3c2b3a;
  --card: #ffe7f6;
  --accent: #c45fff;
  --accent-2: #ff79c6;
  --muted: #7b5f73;
  --radius: 16px;
  --shadow: 0 10px 24px rgba(90, 30, 100, 0.15);

  --badge-normal: #a78bfa; /* lila */
  --badge-sub: #ff9bd6;    /* pink */
  --badge-cancel: #b0a7b6; /* grau */
}

* { box-sizing: border-box; }
html, body {
  margin: 0; padding: 0;
  font-family: "Baloo 2", system-ui, sans-serif;
  color: var(--text);
  background:
    radial-gradient(#ffd0ff 1.6px, transparent 2px) 0 0/16px 16px,
    radial-gradient(#ffe2ff 1.6px, transparent 2px) 8px 8px/16px 16px,
    linear-gradient(#fff7ff, #ffe7f6);
  min-height: 100vh;
}

.app-header {
  display: flex; justify-content: space-between; align-items: center;
  padding: 12px 16px; background: var(--card); box-shadow: var(--shadow);
  border-bottom: 2px solid #ffd3fb;
  position: sticky; top: 0; z-index: 10;
}
.brand { font-weight: 800; letter-spacing: .3px; font-size: 20px; }
.controls button {
  margin-left: 8px; border: none; border-radius: 999px; padding: 8px 12px;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  color: white; cursor: pointer; box-shadow: var(--shadow);
}

.app-main {
  display: grid; grid-template-columns: 280px 1fr; gap: 16px; padding: 16px;
}
.sidebar, .timetable {
  background: var(--card); border-radius: var(--radius); box-shadow: var(--shadow); padding: 12px;
  border: 2px solid #ffd3fb;
}

.hint {
  color: var(--muted);
}

.week-controls {
  display: flex; align-items: center; justify-content: center; margin-bottom: 10px;
}
.week-label {
  font-size: 22px; font-weight: 700; color: var(--accent);
  text-shadow: 0 2px 0 rgba(0,0,0,.05);
}

.grid {
  display: grid;
  grid-template-columns: 100px repeat(5, 1fr);
  gap: 10px;
}

.cell {
  background: #fff; border-radius: var(--radius); min-height: 84px; padding: 8px;
  border: 2px dashed rgba(196, 95, 255, .2);
  position: relative;
}
.cell--time {
  background: #fff; display: flex; align-items: center; justify-content: center;
  font-weight: 700; color: #7c4da3;
}
.cell--head {
  background: #fff; font-weight: 700; color: #7c4da3;
  display: flex; align-items: center; justify-content: center; min-height: 48px;
  border: 2px solid rgba(196, 95, 255, .25);
}

.slot-dropzone {
  position: absolute; inset: 6px; border-radius: 12px;
}
.slot-dropzone.dragover {
  outline: 3px dashed var(--accent-2);
  outline-offset: -4px;
  animation: pulse 0.9s infinite ease-in-out;
}
@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.01); }
  100% { transform: scale(1); }
}

.card {
  background: #fff; border: 2px solid #ffd3fb; border-radius: 14px;
  box-shadow: var(--shadow);
  padding: 8px; margin: 4px 0;
  cursor: grab;
}
.card:active { cursor: grabbing; }
.card-header {
  display: flex; align-items: center; justify-content: space-between; gap: 8px;
}
.card-title {
  font-weight: 800; color: #5b2f8c; display: flex; align-items: center; gap: 6px;
}
.card-meta {
  margin-top: 4px; color: var(--muted); display: flex; gap: 10px; font-size: 14px;
}
.badges { display: flex; gap: 6px; }

.badge {
  display: inline-block; padding: 2px 8px; font-size: 12px; border-radius: 999px; color: white;
}
.badge.normal { background: var(--badge-normal); }
.badge.substitute { background: var(--badge-sub); }
.badge.canceled { background: var(--badge-cancel); }

.sticker-shelf { font-size: 20px; display: flex; gap: 6px; flex-wrap: wrap; }

.modal {
  position: fixed; inset: 0; background: rgba(0,0,0,.3);
  display: grid; place-items: center; z-index: 999;
}
.modal.hidden { display: none; }
.modal-content {
  width: min(620px, 92vw);
  background: #fff; border-radius: var(--radius); padding: 16px; box-shadow: var(--shadow);
  border: 2px solid #ffd3fb;
}
.modal-content h2 { margin: 0 0 10px 0; color: #5b2f8c; }
.modal-content label { display: block; font-weight: 700; margin-top: 8px; }
.modal-content input, .modal-content select {
  width: 100%; padding: 10px; border-radius: 12px; border: 2px solid #f2c6ff; margin-top: 6px;
  font-family: "Baloo 2", sans-serif; font-size: 16px;
}
.modal-actions { display: flex; gap: 8px; margin-top: 12px; }
.modal-actions button {
  border: none; border-radius: 999px; padding: 8px 14px; cursor: pointer; color: white;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
}
.modal-actions #btnDelete { background: #ef6b6b; }
