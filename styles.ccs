:root {
  --mint: #bff5d3;
  --mint-2: #a8ebc4;
  --brown: #5a3d2b;
  --brown-2: #7a5840;
  --cream: #fffaf3;
  --shadow: rgba(90, 61, 43, 0.25);
  --ring: rgba(191, 245, 211, 0.5);
  --grid: #e9f9f0;
}

* {
  box-sizing: border-box;
}

html, body {
  margin: 0;
  padding: 0;
  background: linear-gradient(180deg, var(--cream), #f4fff9 40%);
  color: var(--brown);
  font-family: "Trebuchet MS", "Segoe UI", system-ui, -apple-system, sans-serif;
}

.y2k-header {
  position: sticky;
  top: 0;
  z-index: 5;
  background: linear-gradient(90deg, var(--mint), var(--mint-2));
  border-bottom: 4px solid var(--brown);
  box-shadow: 0 6px 18px var(--shadow);
}

.y2k-header .header-content {
  position: relative;
  padding: 16px 20px 10px 20px;
  text-align: center;
}

.y2k-header h1 {
  margin: 0;
  font-size: 28px;
  letter-spacing: 0.5px;
  color: var(--brown);
  text-shadow: 0 1px 0 #fff, 0 2px 0 #eed, 0 3px 0 #ddd;
  border: 2px dashed var(--brown-2);
  display: inline-block;
  padding: 6px 14px;
  border-radius: 12px;
  background: #ffffff88;
}

.actions {
  display: flex;
  gap: 8px;
  justify-content: center;
  padding: 10px 16px 16px 16px;
  flex-wrap: wrap;
}

.actions button {
  background: var(--brown);
  color: white;
  border: none;
  border-radius: 999px;
  padding: 8px 14px;
  font-weight: 700;
  box-shadow: 0 4px 10px var(--shadow);
  cursor: pointer;
  transition: transform 0.05s ease, box-shadow 0.2s ease, background 0.2s;
  border: 2px solid #fff;
}

.actions button:hover {
  transform: translateY(-1px);
  background: var(--brown-2);
  box-shadow: 0 6px 14px var(--shadow);
}

/* Bow decorations */
.bow {
  position: absolute;
  top: 6px;
  width: 48px;
  height: 30px;
  background: radial-gradient(circle at 25% 50%, var(--mint) 40%, transparent 42%) left / 50% 100% no-repeat,
              radial-gradient(circle at 75% 50%, var(--mint) 40%, transparent 42%) right / 50% 100% no-repeat;
  border-bottom: 4px solid var(--brown);
  border-radius: 0 0 18px 18px;
  filter: drop-shadow(0 3px 6px var(--shadow));
}

.bow-left { left: 16px; transform: rotate(-5deg); }
.bow-right { right: 16px; transform: rotate(5deg); }

/* Layout */
.layout {
  display: grid;
  grid-template-columns: 260px 1fr;
  gap: 16px;
  padding: 16px;
}

@media (max-width: 900px) {
  .layout {
    grid-template-columns: 1fr;
  }
}

/* Sticker panel */
.sticker-panel {
  background: #ffffffcc;
  backdrop-filter: blur(6px);
  border: 2px dashed var(--brown);
  border-radius: 16px;
  padding: 14px;
  box-shadow: 0 6px 16px var(--shadow);
}

.sticker-panel h3 {
  margin: 0 0 8px;
  letter-spacing: 0.5px;
}

.sticker-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 8px;
}

.sticker {
  font-size: 24px;
  padding: 6px 10px;
  background: var(--mint);
  border: 2px solid var(--brown);
  border-radius: 10px;
  cursor: grab;
  user-select: none;
  transition: transform 0.05s ease;
}

.sticker:active {
  cursor: grabbing;
  transform: scale(1.05);
}

.hint {
  font-size: 12px;
  color: var(--brown-2);
}

/* Board */
.board-wrapper {
  position: relative;
}

.board {
  position: relative;
  background: #ffffffd9;
  border: 3px solid var(--brown);
  border-radius: 18px;
  padding: 16px;
  box-shadow: 0 10px 24px var(--shadow);
  overflow: hidden;
}

.board-bows {
  display: flex;
  justify-content: center;
  gap: 18px;
  margin: 6px 0;
}

.tiny-bow {
  width: 28px;
  height: 20px;
  background: radial-gradient(circle at 25% 50%, var(--mint-2) 40%, transparent 42%) left / 50% 100% no-repeat,
              radial-gradient(circle at 75% 50%, var(--mint-2) 40%, transparent 42%) right / 50% 100% no-repeat;
  border-bottom: 3px solid var(--brown);
  border-radius: 0 0 12px 12px;
  filter: drop-shadow(0 2px 4px var(--shadow));
}

/* Timetable */
.timetable {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  background:
    linear-gradient(transparent 49px, var(--grid) 50px) 0 0 / 100% 50px repeat-y,
    linear-gradient(90deg, transparent calc(100% - 1px), var(--grid) calc(100% - 1px)) 0 0 / 1fr 1fr repeat-x;
  overflow: hidden;
  border-radius: 12px;
}

.timetable thead th {
  position: sticky;
  top: 0;
  background: linear-gradient(180deg, #fff, #f7fff9);
  border-bottom: 2px solid var(--brown);
  padding: 12px;
  text-align: center;
  font-weight: 800;
  color: var(--brown);
  z-index: 1;
}

.corner-cell {
  border-right: 2px solid var(--brown);
  min-width: 120px;
  background: linear-gradient(180deg, #fff, #f7fff9);
}

.time-cell {
  background: #fff;
  border-right: 2px solid var(--brown);
  padding: 10px 12px;
  text-align: center;
  font-weight: 700;
}

.slot {
  min-width: 160px;
  min-height: 64px;
  padding: 0;
  border-left: 1px solid var(--grid);
  border-bottom: 1px solid var(--grid);
  position: relative;
  background: #ffffff;
  transition: box-shadow 0.2s ease, transform 0.05s ease;
}

.slot.drag-over {
  outline: 3px dashed var(--ring);
  outline-offset: -3px;
}

.cell-content {
  padding: 10px 12px 24px 12px; /* space for stickers */
  width: 100%;
  height: 100%;
  outline: none;
}

.cell-content:focus {
  box-shadow: 0 0 0 3px var(--ring);
  border-radius: 6px;
}

/* Stickers on board */
.board-sticker {
  position: absolute;
  font-size: 20px;
  cursor: move;
  user-select: none;
  transform: translate(-50%, -50%);
  text-shadow: 0 1px 0 #fff;
  filter: drop-shadow(0 2px 4px var(--shadow));
}

.board-sticker.selected {
  outline: 2px solid var(--mint-2);
  border-radius: 8px;
}

/* Utility */
.footer {
  padding: 20px;
  text-align: center;
  color: var(--brown-2);
}

.note {
  display: inline-block;
  background: #ffffffc0;
  border: 2px dashed var(--brown-2);
  padding: 8px 12px;
  border-radius: 12px;
}

/* Double-click to clear feedback */
.slot.cleared {
  animation: blink 0.4s ease;
}
@keyframes blink {
  0% { background: #fff; }
  50% { background: #eafff3; }
  100% { background: #fff; }
}
