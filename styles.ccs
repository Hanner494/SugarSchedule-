:root {
  /* Farben – braun/hellbraun für Plan, pink-braunes Karo im Hintergrund */
  --brown-700: #533525;
  --brown-600: #6b4530;
  --brown-500: #8b5e3c;
  --brown-300: #caa88d;
  --brown-200: #e7d6c9;
  --brown-100: #f4ebe4;

  --pink-300: #ff8ec0;
  --pink-200: #ffc1dc;

  --mint-500: #7ed9bb;

  --bg: #fff;
  --text: #2b211c;

  --radius-lg: 16px;
  --radius-md: 12px;
  --radius-sm: 10px;

  --shadow-sm: 0 6px 16px rgba(39, 24, 15, 0.08);
  --shadow-md: 0 10px 26px rgba(39, 24, 15, 0.12);

  --badge-normal: #a07b5a;    /* warm braun */
  --badge-sub: #e7a66f;       /* braun-orange */
  --badge-cancel: #9aa7a0;    /* grün-grau */
}

* { box-sizing: border-box; }
html, body {
  margin: 0; padding: 0;
  font-family: "Baloo 2", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Apple Color Emoji", "Segoe UI Emoji";
  color: var(--text);
  min-height: 100vh;

  /* Pink-braunes Karo: zwei diagonale Layer */
  background:
    linear-gradient(45deg, rgba(139,94,60,0.08) 25%, rgba(255,255,255,0) 25%, rgba(255,255,255,0) 75%, rgba(139,94,60,0.08) 75%) 0 0/36px 36px,
    linear-gradient(45deg, rgba(255,142,192,0.12) 25%, rgba(255,255,255,0) 25%, rgba(255,255,255,0) 75%, rgba(255,142,192,0.12) 75%) 18px 18px/36px 36px,
    linear-gradient(90deg, #fff, #fff);
}

/* Header */
.app-header {
  display: grid; grid-template-columns: 1fr auto auto; align-items: center;
  gap: 12px; padding: 12px 16px;
  background: #fff; border-bottom: 2px solid var(--brown-200);
  box-shadow: var(--shadow-sm); position: sticky; top: 0; z-index: 10;
}
.brand { font-weight: 800; letter-spacing: .3px; font-size: 20px; color: var(--brown-700); }
.now { color: var(--brown-600); font-weight: 700; }
.now .sep { opacity: .5; margin: 0 8px; }
.actions button {
  margin-left: 8px; border: none; border-radius: 999px; padding: 8px 12px;
  background: linear-gradient(135deg, var(--brown-500), var(--brown-700));
  color: #fff; cursor: pointer; box-shadow: var(--shadow-sm);
}
.actions button:hover { filter: brightness(1.05); }

/* Layout main */
.app-main {
  display: grid; grid-template-columns: 320px 1fr; gap: 16px; padding: 16px;
}

/* Side Panel */
.side-panel { display: grid; gap: 16px; align-content: start; }
.plant-card, .sticker-card {
  background: #fff; border: 2px solid var(--brown-200); border-radius: var(--radius-lg); padding: 12px;
  box-shadow: var(--shadow-sm);
}
.plant-card h3, .sticker-card h3 { margin: 0 0 8px 0; color: var(--brown-700); }
.inline { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; color: var(--brown-600); }
.countdown { margin-top: 8px; font-weight: 800; color: var(--brown-600); }

/* Pflanze – super hübsch */
.plant-wrap { display: grid; place-items: center; margin-top: 8px; }
.plant {
  position: relative; width: 160px; height: 220px;
  display: grid; place-items: end center;
}
.pot {
  width: 90px; height: 40px; background: var(--brown-500); border-radius: 10px 10px 6px 6px;
  box-shadow: inset 0 -6px 0 rgba(0,0,0,.1), 0 3px 0 rgba(0,0,0,.08);
  position: relative;
}
.pot-lip {
  position: absolute; top: -10px; left: 50%; transform: translateX(-50%);
  width: 110px; height: 20px; background: var(--brown-600); border-radius: 8px;
  box-shadow: 0 4px 0 rgba(0,0,0,.08);
}
.stem {
  position: absolute; bottom: 40px; width: 10px; height: 16px; /* wird per JS skaliert */
  background: #73c9a8; border-radius: 12px;
  box-shadow: inset 0 -6px 0 rgba(0,0,0,.06);
  transform-origin: bottom center; transition: height .6s ease, transform .6s ease;
}
.leaf {
  position: absolute; bottom: 90px; width: 28px; height: 16px; background: #8ae0c4;
  border-radius: 16px 16px 16px 4px; box-shadow: 0 2px 0 rgba(0,0,0,.06);
}
.leaf-left { left: 48px; transform: rotate(-24deg); }
.leaf-right { right: 48px; transform: rotate(24deg); border-radius: 16px 16px 4px 16px; }
.flower {
  position: absolute; bottom: 40px; transform: translateY(0);
  transition: transform .6s ease; font-size: 22px; filter: drop-shadow(0 2px 0 rgba(0,0,0,.06));
}
.sparkle {
  position: absolute; color: #ffcadf; opacity: .8;
  animation: float 3.5s infinite ease-in-out;
}
.sparkle.s1 { left: 20px; bottom: 120px; animation-delay: 0s; }
.sparkle.s2 { right: 24px; bottom: 150px; animation-delay: .7s; }
.sparkle.s3 { left: 46px; bottom: 170px; animation-delay: 1.4s; }
@keyframes float {
  0% { transform: translateY(0) scale(.9); opacity: .6; }
  50% { transform: translateY(-8px) scale(1); opacity: 1; }
  100% { transform: translateY(0) scale(.9); opacity: .6; }
}

/* Sticker */
.hint { color: var(--brown-600); }
.sticker-shelf { display: flex; gap: 8px; flex-wrap: wrap; }
.sticker {
  background: #fff; border: 2px solid var(--brown-200); border-radius: 10px;
  padding: 6px 8px; box-shadow: var(--shadow-sm); cursor: grab; user-select: none;
}
.sticker:active { cursor: grabbing; }

/* Timetable */
.timetable {
  background: #fff; border: 2px solid var(--brown-200);
  border-radius: var(--radius-lg); padding: 12px; box-shadow: var(--shadow-sm);
}
.week-header .title {
  font-weight: 900; color: var(--brown-700); text-align: center; margin-bottom: 10px;
}

.grid {
  display: grid;
  grid-template-columns: 110px repeat(5, 1fr);
  gap: 10px;
}

/* Kopf- und Zeitspalten im soliden Braun/Hellbraun Look */
.cell { background: var(--brown-100); border-radius: var(--radius-md); min-height: 88px; padding: 8px; position: relative; }
.cell--head { background: var(--brown-300); color: #3a2518; font-weight: 900; display: grid; place-items: center; min-height: 52px; }
.cell--time { background: var(--brown-200); color: var(--brown-700); font-weight: 900; }

/* Dropzone */
.slot-dropzone { position: absolute; inset: 6px; border-radius: 12px; border: 2px dashed rgba(139,94,60,.25); }
.slot-dropzone.dragover { outline: 3px dashed var(--brown-500); outline-offset: -4px; }

/* Karten (Stunden) */
.card {
  background: #fff; border: 2px solid var(--brown-200); border-radius: 14px;
  box-shadow: var(--shadow-sm); padding: 8px; margin: 4px 0; cursor: grab;
}
.card:active { cursor: grabbing; }
.card-header { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.card-title { font-weight: 900; color: var(--brown-700); display: flex; align-items: center; gap: 6px; }
.card-title .test-flag { font-size: 16px; }
.card-meta { margin-top: 4px; color: #5f4a3c; display: flex; gap: 12px; font-size: 14px; align-items: center; flex-wrap: wrap; }
.card-meta .teacher::before { content: "👩‍🏫"; margin-right: 4px; }
.card-meta .room::before { content: "🏫"; margin-right: 4px; }
.card-meta .status { font-weight: 800; }
.badges { display: flex; gap: 6px; }
.badge { display: inline-block; padding: 2px 8px; font-size: 12px; border-radius: 999px; color: #fff; box-shadow: var(--shadow-sm); }
.badge.normal { background: var(--badge-normal); }
.badge.substitute { background: var(--badge-sub); }
.badge.canceled { background: var(--badge-cancel); }

/* Sticker, die auf Karten droppen */
.card-stickers { display: flex; gap: 4px; flex-wrap: wrap; margin-top: 4px; }
.card-sticker {
  display: inline-block; padding: 2px 6px; border: 2px solid var(--brown-200);
  border-radius: 8px; background: #fff; user-select: none;
}

/* Modals */
.modal { position: fixed; inset: 0; background: rgba(0,0,0,.35); display: grid; place-items: center; z-index: 999; }
.modal.hidden { display: none; }
.modal-content {
  width: min(720px, 92vw); background: #fff; border-radius: var(--radius-lg);
  padding: 16px; box-shadow: var(--shadow-md); border: 2px solid var(--brown-200);
}
.modal-content h2 { margin: 0 0 10px 0; color: var(--brown-700); }
.form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
.form-grid label { font-weight: 800; color: var(--brown-600); }
.modal-content input, .modal-content select {
  width: 100%; padding: 10px; border-radius: 12px; border: 2px solid var(--brown-200); margin-top: 6px;
  font-family: "Baloo 2", sans-serif; font-size: 16px; background: #fff;
}
.modal-actions { display: flex; gap: 8px; margin-top: 12px; }
.modal-actions button {
  border: none; border-radius: 999px; padding: 8px 14px; cursor: pointer; color: #fff;
  background: linear-gradient(135deg, var(--brown-500), var(--brown-700));
}

@media (max-width: 980px) {
  .app-main { grid-template-columns: 1fr; }
  .form-grid { grid-template-columns: 1fr; }
}
